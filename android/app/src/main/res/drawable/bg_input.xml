<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aster_card_high" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/aster_blue" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aster_bg_deep" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/aster_border_soft" />
        </shape>
    </item>
</selector>
