<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网电脑地址不固定，允许明文 HTTP；Aster 的 HTTPS 自签名证书由 WebView/下载器单独确认。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
